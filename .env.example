# ─────────────────────────────────────────
# APP
# ─────────────────────────────────────────
APP_NAME=VCARD
APP_ENV=production              # local | staging | production
APP_KEY=                        # Run: php artisan key:generate
APP_DEBUG=false
APP_URL=https://your-domain.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file     # file | database
# APP_MAINTENANCE_STORE=database
# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12                # increase for stronger hashing (costs more CPU)

# ─────────────────────────────────────────
# LOGGING
# ─────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug                 # debug | info | notice | warning | error | critical

# ─────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=db                      # use 127.0.0.1 if not running in Docker
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

# ─────────────────────────────────────────
# SESSION
# ─────────────────────────────────────────
SESSION_DRIVER=database         # file | cookie | database | redis
SESSION_LIFETIME=120            # minutes
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=your-domain.com
SESSION_SECURE_COOKIE=true      # set false on local HTTP

# ─────────────────────────────────────────
# CACHE / QUEUE / BROADCAST
# ─────────────────────────────────────────
BROADCAST_CONNECTION=log        # log | pusher | ably | redis | null
FILESYSTEM_DISK=local           # local | public | s3
QUEUE_CONNECTION=database       # sync | database | redis | sqs
CACHE_STORE=database            # database | redis | file | memcached
# CACHE_PREFIX=

# ─────────────────────────────────────────
# MEMCACHED (only if CACHE_STORE=memcached)
# ─────────────────────────────────────────
MEMCACHED_HOST=127.0.0.1

# ─────────────────────────────────────────
# REDIS (only if using redis for cache/queue)
# ─────────────────────────────────────────
REDIS_CLIENT=phpredis           # phpredis | predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─────────────────────────────────────────
# MAIL
# ─────────────────────────────────────────
MAIL_MAILER=log                 # smtp | mailgun | ses | postmark | sendmail | log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─────────────────────────────────────────
# AWS S3 (only if FILESYSTEM_DISK=s3)
# ─────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ─────────────────────────────────────────
# VITE
# ─────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
